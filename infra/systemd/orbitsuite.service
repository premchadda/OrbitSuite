[Unit]
Description=OrbitSuite personal Telegram bot (local polling runtime)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orbitsuite
Group=orbitsuite
WorkingDirectory=/opt/orbitsuite
EnvironmentFile=/etc/orbitsuite/orbitsuite.env
Environment=ORBIT_MODE=polling
Environment=ORBIT_HOST=127.0.0.1
Environment=ORBIT_DB_PATH=/var/lib/orbitsuite/orbitsuite.sqlite
ExecStart=/usr/bin/node /opt/orbitsuite/apps/local/src/runtime.js
Restart=on-failure
RestartSec=15s
TimeoutStopSec=50s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/orbitsuite
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
