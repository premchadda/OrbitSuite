# Copy to .env, restrict file permissions, never commit actual credentials.
BOT_TOKEN=REPLACE_WITH_PRIVATE_BOTFATHER_TOKEN
OWNER_ID=123456789
WEBHOOK_SECRET=GENERATE_AN_UNGUESSABLE_SECRET_AT_LEAST_16_CHARS
MEDIA_WORKER_KEY=GENERATE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_24_CHARS
ORBIT_MODE=polling
ORBIT_STORE=sqlite
ORBIT_DB_PATH=data/orbitsuite.sqlite
ORBIT_HOST=127.0.0.1
ORBIT_PORT=8787
# Optional read-only Windows staging checks; use a PRIVATE test supergroup ID.
# ORBIT_TEST_CHAT_ID=-1001234567890
# ORBIT_TEST_DEST_CHAT_ID=-1009876543210
ORBIT_TICK_SECONDS=5
# Opt-in conservative stale-job review (stuck sends are NEVER auto-retried).
ORBIT_STALE_SECONDS=600
# Large media uploads get a longer timeout, refreshed via media heartbeat.
ORBIT_MEDIA_STALE_SECONDS=21600
# Set to 1 for owner-only Telegram health/stale-job alerts.
ORBIT_ALERTS=0
ORBIT_ALERT_COOLDOWN_SECONDS=3600
# Optional PostgreSQL: ORBIT_STORE=postgres and DATABASE_URL or PG* variables.
# Do not commit real credentials; local SQLite remains default.
# DATABASE_URL=postgresql://user:password@localhost:5432/orbitsuite
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=orbitsuite
# PGUSER=orbitsuite
# PGPASSWORD=REPLACE_ME
# Docker PostgreSQL overlay: set a strong random POSTGRES_PASSWORD in .env.
# POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
# Optional multi-instance Redis lease, not required for one bot instance.
# REDIS_URL=redis://127.0.0.1:6379
ORBIT_MEDIA_HOSTS=youtube.com,youtu.be,vimeo.com
ORBIT_POLL_SECONDS=30
# Optional Telegram Mini App (owner-only): public HTTPS origin, with NO path.
# ORBIT_PUBLIC_URL=https://bot.example.com
# Optional RSS/wiki/RDAP parser. Use infra/compose.parser.yaml for local-only.
# ORBIT_RSS_HOSTS=feeds.example.org,news.example.com
# ORBIT_RSS_PARSER_TOKEN=ANOTHER_PRIVATE_TOKEN_MINIMUM_16_CHARACTERS
# ORBIT_RSS_PARSER_URL=https://your-private-parser.example.com
# ORBIT_RSS_ALLOW_LOCAL_HTTP=0
# Optional owner-only text inference; defaults OFF via /feature personal_ai.
# Install a trusted local Ollama server (Node self-host) or configure a
# trusted HTTPS Ollama-compatible endpoint; only explicit commands send text.
# ORBIT_AI_BASE_URL=http://127.0.0.1:11434
# ORBIT_AI_MODEL=your-installed-model-name
# ORBIT_AI_KEY=DIFFERENT_LONG_PRIVATE_KEY_IF_HTTPS_PROVIDER_REQUIRES_ONE
# Optional local whisper.cpp transcript service: install model and whisper-cli
# yourself, then enable /feature personal_transcription on; no auto-download.
# ORBIT_WHISPER_MODEL_ROOT=/models
# ORBIT_WHISPER_MODEL=ggml-tiny.bin
